# Anthropic API key for the "Ask about me" chat (server-side only, never exposed to the browser)
ANTHROPIC_API_KEY=
# Formspree form ID (the part after https://formspree.io/f/). Without it, the form falls back to mailto.
NEXT_PUBLIC_FORMSPREE_ID=
# Public URL used for Open Graph / canonical links
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
